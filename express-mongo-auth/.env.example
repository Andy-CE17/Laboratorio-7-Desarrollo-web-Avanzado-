PORT=3000
MONGODB_URI=mongodb://mongo:27017/auth_db
# En producción se puede usar una URI sin credenciales y enviar el usuario y
# la contraseña por separado para aceptar contraseñas con caracteres especiales.
# MONGO_URI=mongodb+srv://cluster.mongodb.net/auth_db?retryWrites=true&w=majority
# MONGO_USER=usuario_atlas
# MONGO_PASSWORD=contraseña_atlas
JWT_SECRET=coloca_aqui_una_clave_segura
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10
ADMIN_NAME=Administrador
ADMIN_LAST_NAME=Principal
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD="Admin#12345"
ADMIN_PHONE_NUMBER=999999999
ADMIN_BIRTHDATE=1995-01-01
